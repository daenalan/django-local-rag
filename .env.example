DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=host1,host2

POSTGRES_DB=your_db
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=your_db_host
POSTGRES_PORT=your_db_port

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=deepseek-r1
OLLAMA_EMBED_MODEL=embeddinggemma-2:latest

OLLAMA_CHAT_MODEL_TEMPERATURE=0.2
OLLAMA_CHAT_MODEL_CTX_WINDOW=2048
OLLAMA_CHAT_MODEL_OUTPUT_LENGTH=192

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4